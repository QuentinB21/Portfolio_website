{
	email {$ACME_EMAIL}
}

{$WWW_DOMAIN} {
	redir https://{$PRIMARY_DOMAIN}{uri} permanent
}

{$PRIMARY_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
	}

	handle /stats.js {
		uri replace /stats.js /script.js
		reverse_proxy umami:3000
	}

	handle /api/send* {
		reverse_proxy umami:3000
	}

	# TradeCopilot is published under a sub-path of the main domain while
	# staying deployed from its own repository and compose stack.
	redir /projets/TradeCopilot /projets/TradeCopilot/ 308

	@tradecopilot_auth_callback path /projets/TradeCopilot/auth/callback*
	handle @tradecopilot_auth_callback {
		uri strip_prefix /projets/TradeCopilot
		reverse_proxy {$TRADECOPILOT_FRONTEND_UPSTREAM} {
			header_up X-Forwarded-Prefix /projets/TradeCopilot
		}
	}

	@tradecopilot_api path /projets/TradeCopilot/api/*
	handle @tradecopilot_api {
		uri strip_prefix /projets/TradeCopilot
		reverse_proxy {$TRADECOPILOT_API_UPSTREAM} {
			header_up X-Forwarded-Prefix /projets/TradeCopilot
		}
	}

	@tradecopilot_auth path /projets/TradeCopilot/auth/*
	handle @tradecopilot_auth {
		uri strip_prefix /projets/TradeCopilot
		reverse_proxy {$TRADECOPILOT_AUTH_UPSTREAM} {
			header_up X-Forwarded-Prefix /projets/TradeCopilot
		}
	}

	@tradecopilot_front path /projets/TradeCopilot/* /projets/TradeCopilot
	handle @tradecopilot_front {
		uri strip_prefix /projets/TradeCopilot
		reverse_proxy {$TRADECOPILOT_FRONTEND_UPSTREAM} {
			header_up X-Forwarded-Prefix /projets/TradeCopilot
		}
	}

	# Mail Manager Workflow keeps its own compose stack. Only its public HTTP
	# entry points are reachable through the shared proxy network.
	redir /projets/MailManager /projets/MailManager/ 308

	# OAuth discovery for an issuer with a path (RFC 8414 / OIDC).
	# Keep these exact routes ahead of the portfolio SPA fallback.
	@mailmanager_oauth_metadata path /.well-known/oauth-authorization-server/projets/MailManager/auth/realms/mail-manager /.well-known/openid-configuration/projets/MailManager/auth/realms/mail-manager
	handle @mailmanager_oauth_metadata {
		rewrite * /auth/realms/mail-manager/.well-known/openid-configuration
		reverse_proxy {$MAILMANAGER_AUTH_UPSTREAM} {
			header_up X-Forwarded-Prefix /projets/MailManager
		}
	}

	handle /.well-known/oauth-protected-resource/projets/MailManager/api/mcp {
		rewrite * /api/mcp/oauth-protected-resource
		reverse_proxy {$MAILMANAGER_API_UPSTREAM} {
			header_up X-Forwarded-Prefix /projets/MailManager
		}
	}

	@mailmanager_api path /projets/MailManager/api/* /projets/MailManager/health
	handle @mailmanager_api {
		uri strip_prefix /projets/MailManager
		reverse_proxy {$MAILMANAGER_API_UPSTREAM} {
			header_up X-Forwarded-Prefix /projets/MailManager
		}
	}

	@mailmanager_auth path /projets/MailManager/auth /projets/MailManager/auth/*
	handle @mailmanager_auth {
		uri strip_prefix /projets/MailManager
		reverse_proxy {$MAILMANAGER_AUTH_UPSTREAM} {
			header_up X-Forwarded-Prefix /projets/MailManager
		}
	}

	@mailmanager_webhook path /projets/MailManager/webhook/*
	handle @mailmanager_webhook {
		uri strip_prefix /projets/MailManager
		reverse_proxy {$MAILMANAGER_WORKFLOW_UPSTREAM} {
			header_up X-Forwarded-Prefix /projets/MailManager
		}
	}

	@mailmanager_front path /projets/MailManager/* /projets/MailManager
	handle @mailmanager_front {
		uri strip_prefix /projets/MailManager
		reverse_proxy {$MAILMANAGER_FRONTEND_UPSTREAM} {
			header_up X-Forwarded-Prefix /projets/MailManager
		}
	}

	handle {
		reverse_proxy portfolio:80
	}
}

{$UMAMI_DOMAIN} {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	reverse_proxy umami:3000
}
